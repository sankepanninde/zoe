generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// TENANT: Iglesia
// ===========================================
model Church {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Bogota")
  country   String   @default("CO")
  phone     String?
  email     String?
  address   String?
  logoUrl   String?
  active    Boolean  @default(true)

  plan             Plan     @default(FREE)
  trialEndsAt      DateTime?
  subscriptionId   String?
  subscriptionEnds DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  serviceTypes   ServiceType[]
  services       Service[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]
  ministries     Ministry[]

  @@index([slug])
  @@index([active])
}

enum Plan {
  FREE
  BASIC
  STANDARD
  PRO
}

// ===========================================
// USUARIOS
// ===========================================
model User {
  id           String   @id @default(cuid())
  churchId     String
  church       Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?

  role               Role     @default(TECHNICIAN)
  position           String?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments    Assignment[]
  availabilities Availability[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  ministries     UserMinistry[]

  @@unique([churchId, email])
  @@index([churchId])
  @@index([email])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  LEADER
  TECHNICIAN
}

// ===========================================
// REFRESH TOKENS
// ===========================================
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchId   String
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([churchId])
  @@index([expiresAt])
}

// ===========================================
// TIPOS DE SERVICIO
// ===========================================
model ServiceType {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String   @default("#6366f1")
  icon        String?
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    Service[]

  @@unique([churchId, name])
  @@index([churchId])
}

// ===========================================
// SERVICIOS
// ===========================================
model Service {
  id            String        @id @default(cuid())
  churchId      String
  church        Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)

  serviceTypeId String
  serviceType   ServiceType   @relation(fields: [serviceTypeId], references: [id])

  title         String?
  date          DateTime
  startTime     String
  endTime       String
  location      String?
  notes         String?

  // ===========================================
  // CAMPOS ESPECÍFICOS PARA EL MINISTERIO DE SONIDO
  // ===========================================
  soundCheckTime String?
  sceneName      String?
  patchName      String?
  inputListCount Int?
  setlistUrl     String?

  status        ServiceStatus @default(PENDING)
  isGenerated   Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignments   Assignment[]

  @@index([churchId])
  @@index([churchId, date])
  @@index([serviceTypeId])
}

enum ServiceStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ===========================================
// ASIGNACIONES
// ===========================================
model Assignment {
  id          String            @id @default(cuid())
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  position    String
  status      AssignmentStatus  @default(PENDING)
  confirmedAt DateTime?
  notes       String?

  ministryId  String?
  ministry    Ministry?         @relation(fields: [ministryId], references: [id], onDelete: SetNull)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([serviceId, userId])
  @@index([serviceId])
  @@index([userId])
  @@index([ministryId])
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// ===========================================
// DISPONIBILIDAD
// ===========================================
model Availability {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime
  available  Boolean  @default(true)
  reason     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ===========================================
// AUDIT LOG
// ===========================================
model AuditLog {
  id         String   @id @default(cuid())
  churchId   String
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([churchId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
// ===========================================
// MINISTERIOS
// ===========================================
model Ministry {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  name      String
  color     String   @default("#6366f1")
  icon      String?
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserMinistry[]
  assignments Assignment[]

  @@unique([churchId, name])
  @@index([churchId])
  @@index([active])
}

// ===========================================
// USUARIO ↔ MINISTERIO (N:M)
// ===========================================
model UserMinistry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  isLeader   Boolean  @default(false)
  position   String?

  createdAt  DateTime @default(now())

  @@unique([userId, ministryId])
  @@index([userId])
  @@index([ministryId])
  @@index([isLeader])
} 