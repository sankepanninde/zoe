# ===========================================
# ZOE — Backend
# ===========================================

# SERVIDOR
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# BASE DE DATOS (PostgreSQL)
DATABASE_URL="postgresql://zoe:zoe_dev_password@localhost:5432/zoe_dev?schema=public"

# AUTENTICACIÓN JWT
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REEMPLAZA_ESTO_CON_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=REEMPLAZA_ESTO_CON_OTRO_SECRETO_LARGO_Y_ALEATORIO
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# COOKIES
COOKIE_SECRET=REEMPLAZA_ESTO_CON_OTRO_SECRETO_LARGO_Y_ALEATORIO
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false